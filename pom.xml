<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aegislens</groupId>
  <artifactId>aegislens</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>AegisLens</name>

  <properties>
    <maven.compiler.release>26</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>26.0.2</javafx.version>
    <!-- Slow performance tests (@Tag("perf")) are skipped by default.
         Run them with: mvn test -Dgroups=perf -DexcludedGroups=none -->
    <excludedGroups>perf</excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.54.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.23.0</version>
    </dependency>
    <!-- sqlite-jdbc declares slf4j-api as OPTIONAL, so it is not pulled in transitively; add it explicitly. 
         (Without an SLF4J provider it prints one harmless "no providers" notice and logs nothing.) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- Tests never use real keys or webhooks, even on a machine that has them set (no real network, no costs). -->
          <environmentVariables>
            <CLAUDE_API_KEY></CLAUDE_API_KEY>
            <GEMINI_API_KEY></GEMINI_API_KEY>
            <LOCAL_LLM_API_KEY></LOCAL_LLM_API_KEY>
            <SPLITSHIELD_TOKEN></SPLITSHIELD_TOKEN>
            <AEGISLENS_WEBHOOK_URL></AEGISLENS_WEBHOOK_URL>
            <VT_API_KEY></VT_API_KEY>
            <AEGISLENS_ENABLE_REAL_SANDBOX></AEGISLENS_ENABLE_REAL_SANDBOX>
          </environmentVariables>
        </configuration>
      </plugin>

      <!-- Test coverage (R13): report in target/site/jacoco; the check enforces 70 % lines on the logic packages -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <executions>
          <execution>
            <id>prepare</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.aegislens.core</include>
                    <include>com.aegislens.malware</include>
                    <include>com.aegislens.intrusion</include>
                    <include>com.aegislens.web</include>
                    <include>com.aegislens.ai</include>
                    <include>com.aegislens.db</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- `mvn javafx:run` for development -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.aegislens.ui.AegisLensApp</mainClass>
        </configuration>
      </plugin>

      <!--
        `mvn package` builds ONE runnable fat JAR: target/aegislens-1.0.0.jar
        Run it with:  java -jar target/aegislens-1.0.0.jar
        NOTE: JavaFX ships native libraries per operating system, so the fat JAR contains the natives of
        the OS it was BUILT on. Our code has no OS-specific parts; CI builds one JAR per OS
        (see .github/workflows/ci.yml). The main class is Launcher (not an Application subclass) so the
        fat JAR starts without module-path errors.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.aegislens.ui.Launcher</mainClass>
                  <!-- JDK 24+ warns when native code (SQLite, JavaFX) loads; this manifest entry allows it for a runnable JAR (JDK 22+ feature; confirm on first run) -->
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
